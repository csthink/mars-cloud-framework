<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mars.cloud</groupId>
    <artifactId>mars-cloud-dependencies</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>mars-cloud-dependencies</name>
    <description>mars-cloud 依赖管理 BOM：统一管理 Spring Boot / Spring Cloud / Spring Cloud Alibaba / 内部模块 / 常用依赖的版本</description>

    <!--
      本模块是 mars-cloud 全仓的「版本唯一出口」。
      所有模块以它为 parent，依赖版本只在这里声明一次。
    -->
    <properties>
        <java.version>25</java.version>
        <!-- 统一编译/依赖版本 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <spring-boot.version>4.0.8</spring-boot.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>

        <!-- 内部模块版本 -->
        <mars-cloud-common.version>1.0.0-SNAPSHOT</mars-cloud-common.version>
        <mars-cloud-core-spring-boot-starter.version>1.0.0-SNAPSHOT</mars-cloud-core-spring-boot-starter.version>
        <mars-cloud-mvc-spring-boot-starter.version>1.0.0-SNAPSHOT</mars-cloud-mvc-spring-boot-starter.version>
        <mars-cloud-mysql.version>1.0.0-SNAPSHOT</mars-cloud-mysql.version>
        <mars-cloud-nacos-spring-boot-starter.version>1.0.0-SNAPSHOT</mars-cloud-nacos-spring-boot-starter.version>
        <mars-cloud-feign-spring-boot-starter.version>1.0.0-SNAPSHOT</mars-cloud-feign-spring-boot-starter.version>
        <mars-cloud-security-spring-boot-starter.version>1.0.0-SNAPSHOT</mars-cloud-security-spring-boot-starter.version>
        <mars-cloud-security-feign.version>1.0.0-SNAPSHOT</mars-cloud-security-feign.version>
        <mars-cloud-security-test-support.version>1.0.0-SNAPSHOT</mars-cloud-security-test-support.version>
        <mars-cloud-rocketmq-spring-boot-starter.version>1.0.0-SNAPSHOT</mars-cloud-rocketmq-spring-boot-starter.version>
        <mars-cloud-observability-spring-boot-starter.version>1.0.0-SNAPSHOT</mars-cloud-observability-spring-boot-starter.version>
        <mars-cloud-sentinel-spring-boot-starter.version>1.0.0-SNAPSHOT</mars-cloud-sentinel-spring-boot-starter.version>

        <!-- 常用依赖版本 -->
        <lombok.version>1.18.40</lombok.version>
        <!--
          Jackson：Boot 4.0.8 的 jackson-bom 管的是 3.1.5 / 注解 2.21。
          mars-cloud-common 不依赖 Spring，拿不到 Boot 的依赖管理，
          所以在这里把版本显式钉住，升级 Boot 时需一并核对。
        -->
        <jackson3.version>3.1.5</jackson3.version>
        <jackson-annotations.version>2.21</jackson-annotations.version>
        <hutool-all.version>5.8.47</hutool-all.version>
        <hutool-core.version>5.8.47</hutool-core.version>
        <!--
          RocketMQ 管理 API（DefaultMQAdminExt）所在的 artifact。SCA BOM 只托管 rocketmq-client 与 rocketmq-acl，
          这里的版本必须与 SCA BOM 的 rocketmq.version 一致（2025.1.0.0 对应 5.3.1），升级 SCA 时一并核对。
          fastjson 家族不在这里管理：binder 与 rocketmq-common 传递引入的 com.alibaba:fastjson 由 SCA BOM 钉版本，
          本项目代码不使用它，也不单独抬 fastjson2 核心的版本。
        -->
        <rocketmq-tools.version>5.3.1</rocketmq-tools.version>
        <!--
          实例监控：Spring Boot Admin 4.0.4 依赖 spring-boot-starter 4.0.5，与本项目的 Boot 4.0.x 同线。
          **不要升到 4.1.x**，它依赖 Boot 4.1.0。
          链路追踪与指标不在这里登记版本，它们各自的托管来源是：
          spring-boot-starter-opentelemetry 由 spring-boot-dependencies 直接托管；
          micrometer-registry-prometheus 由它导入的 micrometer-bom 托管；
          opentelemetry-exporter-sender-jdk 由它导入的 opentelemetry-bom 托管。
          在这里单独钉版本会与 Boot 基线脱钩。
        -->
        <spring-boot-admin.version>4.0.4</spring-boot-admin.version>
        <!--
          Sentinel 记录日志与命令中心日志的 slf4j 实现。SCA BOM 只托管 Sentinel 的部分模块，不包含这一个；
          这里的版本必须与 SCA BOM 的 sentinel.version 一致（2025.1.0.0 对应 1.8.9），升级 SCA 时一并核对。
        -->
        <sentinel-logging-slf4j.version>1.8.9</sentinel-logging-slf4j.version>
        <!-- MyBatis-Plus 的 Boot 4 专用 starter 是独立 artifactId，不是同一个包升版本 -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <!-- 3.5.9 起分页等依赖 JSqlParser 的拦截器被拆到独立 artifact -->
        <mybatis-plus-jsqlparser.version>3.5.17</mybatis-plus-jsqlparser.version>
        <mybatis-plus-generator.version>3.5.3.1</mybatis-plus-generator.version>
        <commons-lang3.version>3.17.0</commons-lang3.version>
        <commons-collections4.version>4.5.0</commons-collections4.version>
        <commons-codec.version>1.18.0</commons-codec.version>
        <transmittable-thread-local.version>2.12.3</transmittable-thread-local.version>
        <!--
          分布式锁：框架**不引入**任何锁实现（lock4j / Redisson 都不引）。
          锁异常类型由 mars-cloud-common 提供，见 LockFailureException。
        -->
        <!--
          接口文档：3.0.3 的 parent 是 spring-boot-starter-parent:4.0.5，与本项目的 Boot 4.0.x 同线。
          **不要升到 3.1.x**——它的 parent 是 Boot 4.1.0。
        -->
        <springdoc-openapi.version>3.0.3</springdoc-openapi.version>

        <!-- 构建插件版本：surefire 钉在 Maven 3.9.14 默认绑定的同一版本，避免随 Maven 安装漂移 -->
        <maven-surefire-plugin.version>3.5.4</maven-surefire-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <!-- compiler 钉在各框架模块已在用的版本；pluginManagement 里不钉版本会让 Maven 每次构建 BOM 都去解析最新版 -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <!--
          surefire argLine 的晚绑定基座。下面 pluginManagement 里的 argLine 以 @{argLine} 开头，
          这里必须存在，否则 @{argLine} 会以字面量进测试 JVM 命令行。
          -Xshare:off 关闭测试 JVM 的类数据共享，避免 Mockito agent 扩展 bootstrap classpath 时的提示。
          sun-misc-unsafe-memory-access=allow（JVM 参数，前置两个连字符）：RocketMQ 客户端一旦加载就经
          fastjson2 的 JDKUtils 调用 sun.misc.Unsafe::arrayBaseOffset，JDK 24 起（JEP 498）默认打印弃用警告，
          验证脚本把它视为未知诊断。应用 JVM 已由下面 spring-boot-maven-plugin 的 jvmArguments 与容器入口带同一参数。
          将来接 jacoco 之类会改写 argLine 属性的工具时，它们的参数会自动接在前面，不要覆盖
          pluginManagement 里那一行。
        -->
        <argLine>-Xshare:off --sun-misc-unsafe-memory-access=allow</argLine>
    </properties>

    <!--
      说明：
        1. BOM 只管理版本，不打包 Jar。
        2. 所有模块以本模块为 parent，可自动继承版本。
        3. 内部模块 mars-cloud-* 只声明版本。
    -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud Alibaba BOM -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块版本 -->
            <dependency>
                <groupId>com.mars.cloud</groupId>
                <artifactId>mars-cloud-common</artifactId>
                <version>${mars-cloud-common.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mars.cloud</groupId>
                <artifactId>mars-cloud-core-spring-boot-starter</artifactId>
                <version>${mars-cloud-core-spring-boot-starter.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mars.cloud</groupId>
                <artifactId>mars-cloud-mvc-spring-boot-starter</artifactId>
                <version>${mars-cloud-mvc-spring-boot-starter.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mars.cloud</groupId>
                <artifactId>mars-cloud-mysql</artifactId>
                <version>${mars-cloud-mysql.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mars.cloud</groupId>
                <artifactId>mars-cloud-nacos-spring-boot-starter</artifactId>
                <version>${mars-cloud-nacos-spring-boot-starter.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mars.cloud</groupId>
                <artifactId>mars-cloud-feign-spring-boot-starter</artifactId>
                <version>${mars-cloud-feign-spring-boot-starter.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mars.cloud</groupId>
                <artifactId>mars-cloud-security-spring-boot-starter</artifactId>
                <version>${mars-cloud-security-spring-boot-starter.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mars.cloud</groupId>
                <artifactId>mars-cloud-security-feign</artifactId>
                <version>${mars-cloud-security-feign.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mars.cloud</groupId>
                <artifactId>mars-cloud-security-test-support</artifactId>
                <version>${mars-cloud-security-test-support.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mars.cloud</groupId>
                <artifactId>mars-cloud-rocketmq-spring-boot-starter</artifactId>
                <version>${mars-cloud-rocketmq-spring-boot-starter.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mars.cloud</groupId>
                <artifactId>mars-cloud-observability-spring-boot-starter</artifactId>
                <version>${mars-cloud-observability-spring-boot-starter.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mars.cloud</groupId>
                <artifactId>mars-cloud-sentinel-spring-boot-starter</artifactId>
                <version>${mars-cloud-sentinel-spring-boot-starter.version}</version>
            </dependency>

            <!-- 常用依赖版本声明 -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool-all.version}</version>
            </dependency>

            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-core</artifactId>
                <version>${hutool-core.version}</version>
            </dependency>

            <!-- RocketMQ 管理 API：只登记版本，由需要核验或创建主题与消费组的 starter 引用 -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-tools</artifactId>
                <version>${rocketmq-tools.version}</version>
            </dependency>

            <!-- 实例监控服务端：只登记版本，由服务仓的 mars-cloud-monitor 引用 -->
            <dependency>
                <groupId>de.codecentric</groupId>
                <artifactId>spring-boot-admin-starter-server</artifactId>
                <version>${spring-boot-admin.version}</version>
            </dependency>

            <!-- Sentinel 的记录日志与命令中心日志经 slf4j 输出：只登记版本，供 mars-cloud-sentinel-spring-boot-starter 引用 -->
            <dependency>
                <groupId>com.alibaba.csp</groupId>
                <artifactId>sentinel-logging-slf4j</artifactId>
                <version>${sentinel-logging-slf4j.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-collections4</artifactId>
                <version>${commons-collections4.version}</version>
            </dependency>

            <dependency>
                <groupId>commons-codec</groupId>
                <artifactId>commons-codec</artifactId>
                <version>${commons-codec.version}</version>
            </dependency>

            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>transmittable-thread-local</artifactId>
                <version>${transmittable-thread-local.version}</version>
            </dependency>

            <!-- MyBatis-Plus：Boot 4 用专用 artifactId -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus-jsqlparser.version}</version>
            </dependency>

            <!-- 接口文档 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>

            <!-- MyBatis-Plus 代码生成器 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-generator</artifactId>
                <version>${mybatis-plus-generator.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!--
          写在 <plugins> 而不是 <pluginManagement>：pluginManagement 只管「被用到时的配置」，
          不会让一个没人声明的插件执行。这里需要 dependency:properties 在每个子模块真的跑起来，
          把每个依赖的 jar 绝对路径暴露成 Maven 属性（形如 ${groupId:artifactId:type}），
          供下面 surefire 的 -javaagent 引用。
        -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven-dependency-plugin.version}</version>
                <executions>
                    <execution>
                        <id>expose-dependency-paths</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <!--
                          测试 JVM 以 -javaagent 预加载 mockito-core。

                          原因：Mockito 5 的 inline mock maker 默认在运行期通过 byte-buddy-agent 自附加，
                          JDK 21 起（JEP 451）动态加载 agent 会打印
                          「A Java agent has been loaded dynamically」并预告未来默认禁止。
                          预加载是 Mockito 官方推荐的做法；-XX:+EnableDynamicAgentLoading 只是关掉警告。

                          ${org.mockito:mockito-core:jar} 由上面的 dependency:properties 提供，
                          只在测试 classpath 含 mockito-core 的模块里存在。全仓约定：有测试的模块
                          必须依赖 spring-boot-starter-test（它带来 mockito-core）；不满足时该属性
                          不会被解析，测试 JVM 会因 -javaagent 指向字面量而起不来——这是故意的
                          fail-loud，不要用 skip 绕过。见 CONTRIBUTING.md。

                          enable-native-access=ALL-UNNAMED（JVM 参数，前置两个连字符）：classpath 上带 Netty
                          平台原生库的模块（Reactor Netty 即如此：macOS 的 DNS 解析器、Linux 的 epoll）在 JDK 24 起
                          （JEP 472）调用 System::loadLibrary 时会打印「A restricted method in
                          java.lang.System has been called」警告，后续版本会改为拒绝。测试 JVM 会真的
                          发起 HTTP 调用，所以这里也要带上；没有原生库的模块带上无副作用。
                        -->
                        <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} --enable-native-access=ALL-UNNAMED</argLine>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <!--
                          保留方法参数名。Spring 6.1 起靠参数名解析 @RequestParam /
                          @PathVariable / @RequestBody 的参数名，缺了它运行期会抛
                          IllegalArgumentException: Name for argument of type [...] not specified。

                          放在这里而不是「请各服务自己记得开」：所有模块的 parent 都是本 BOM，
                          写在这里等于对全仓生效，且新增服务不会漏。
                        -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <configuration>
                        <!--
                          mvn spring-boot:run / spring-boot:start 拉起的应用 JVM 统一带上这个参数。

                          原因：nacos-client 3.1.1 内部 shade 的 Guava 调用 sun.misc.Unsafe 的
                          内存访问方法，JDK 24 起（JEP 498）默认在首次调用时打印弃用警告，
                          后续版本会先改为 debug 再改为 deny。这是 nacos 上游问题
                          （https://github.com/alibaba/nacos/issues/14070），业务服务只要引入
                          nacos starter 就会触发；本参数是 JDK 给出的规避方式。

                          enable-native-access=ALL-UNNAMED（JVM 参数，前置两个连字符）：classpath 上带 Netty
                          平台原生库的服务（响应式栈的网关即如此）在 JDK 24 起（JEP 472）加载原生库时会打印
                          「A restricted method in java.lang.System has been called」警告，后续版本会
                          改为拒绝。没有原生库的服务带上无副作用，所以统一给出。

                          打包后的 jar 不经过本插件启动，容器与脚本里的 java -jar 命令需要
                          自行带上同一组参数。测试 JVM 不经过本插件：Unsafe 那条由上面 properties 里的
                          argLine 基座给出（RocketMQ 客户端一加载就触发），native-access 那条由 surefire 的
                          argLine 给出。
                        -->
                        <jvmArguments>--sun-misc-unsafe-memory-access=allow --enable-native-access=ALL-UNNAMED</jvmArguments>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
